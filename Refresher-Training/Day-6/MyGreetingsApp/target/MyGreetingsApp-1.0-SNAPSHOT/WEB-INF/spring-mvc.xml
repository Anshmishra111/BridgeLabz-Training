<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd
           http://www.springframework.org/schema/mvc
           http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!-- ================================================================
         Enable Spring MVC annotation-driven configuration.
         Registers @Controller, @RequestMapping, @GetMapping, @PostMapping,
         @ModelAttribute, @RequestParam, RedirectAttributes, etc.
         ================================================================ -->
    <mvc:annotation-driven/>

    <!-- ================================================================
         Component Scan — Spring will discover all @Controller, @Service,
         @Repository, @Component beans under com.greetings package.
         ================================================================ -->
    <context:component-scan base-package="com.greetings"/>

    <!-- ================================================================
         InternalResourceViewResolver — maps logical view names to JSP files.
         e.g. return "home" → resolves to /WEB-INF/views/home.jsp
         ================================================================ -->
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/views/"/>
        <property name="suffix" value=".jsp"/>
    </bean>

    <!-- ================================================================
         Static resources — serve CSS, JS, images from /resources/
         without routing through the DispatcherServlet.
         ================================================================ -->
    <mvc:resources mapping="/resources/**" location="/resources/"/>

</beans>
